'use client'

import { useState } from 'react'
import { MATERIALS, MaterialType, calculatePrice, formatPrice, validateDimensions } from '../utils/pricing'

interface MeasurementsFormProps {
  onProceedToCheckout: (data: {
    width: number
    height: number
    material: MaterialType
    price: number
  }) => void
}

export default function MeasurementsForm({ onProceedToCheckout }: MeasurementsFormProps) {
  const [width, setWidth] = useState<string>('3.2')
  const [height, setHeight] = useState<string>('2.4')
  const [material, setMaterial] = useState<MaterialType>('peel_stick')
  const [error, setError] = useState<string | null>(null)

  const widthNum = parseFloat(width) || 0
  const heightNum = parseFloat(height) || 0

  // Calculate pricing
  const pricing = widthNum > 0 && heightNum > 0
    ? calculatePrice(widthNum, heightNum, material)
    : null

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault()
    setError(null)

    // Validate dimensions
    const validationError = validateDimensions(widthNum, heightNum)
    if (validationError) {
      setError(validationError)
      return
    }

    if (!pricing) {
      setError('Please enter valid dimensions')
      return
    }

    // Proceed to checkout
    onProceedToCheckout({
      width: widthNum,
      height: heightNum,
      material,
      price: pricing.total
    })
  }

  return (
    <div className="w-full max-w-2xl mx-auto">
      <form onSubmit={handleSubmit} className="card-dark p-6">
        {/* Dimensions */}
        <div className="mb-6">
          <h3 className="text-lg font-semibold mb-4" style={{ color: 'var(--text-primary)' }}>
            Wall Dimensions
          </h3>
          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="block text-sm font-medium mb-2" style={{ color: 'var(--text-secondary)' }}>
                Width (meters)
              </label>
              <input
                type="number"
                step="0.1"
                min="0.5"
                max="10"
                value={width}
                onChange={(e) => setWidth(e.target.value)}
                className="w-full px-4 py-2 rounded-lg focus:outline-none transition-all input-dark"
                placeholder="3.2"
              />
            </div>
            <div>
              <label className="block text-sm font-medium mb-2" style={{ color: 'var(--text-secondary)' }}>
                Height (meters)
              </label>
              <input
                type="number"
                step="0.1"
                min="0.5"
                max="10"
                value={height}
                onChange={(e) => setHeight(e.target.value)}
                className="w-full px-4 py-2 rounded-lg focus:outline-none transition-all input-dark"
                placeholder="2.4"
              />
            </div>
          </div>
          <p className="mt-2 text-xs" style={{ color: 'var(--text-muted)' }}>
            Measure your wall width and height in meters (0.5m - 10m)
          </p>
        </div>

        {/* Material Selection */}
        <div className="mb-6">
          <h3 className="text-lg font-semibold mb-4" style={{ color: 'var(--text-primary)' }}>
            Material Type
          </h3>
          <div className="space-y-3">
            {(Object.keys(MATERIALS) as MaterialType[]).map((key) => {
              const mat = MATERIALS[key]
              return (
                <label
                  key={key}
                  className="flex items-start p-4 border-2 rounded-lg cursor-pointer transition-all"
                  style={{
                    borderColor: material === key ? 'var(--accent-primary)' : 'var(--border-color)',
                    background: material === key ? 'rgba(139, 92, 246, 0.1)' : 'var(--bg-secondary)'
                  }}
                >
                  <input
                    type="radio"
                    name="material"
                    value={key}
                    checked={material === key}
                    onChange={(e) => setMaterial(e.target.value as MaterialType)}
                    className="mt-1 mr-3 accent-[var(--accent-primary)]"
                  />
                  <div className="flex-1">
                    <div className="flex items-center justify-between mb-1">
                      <span className="font-medium" style={{ color: 'var(--text-primary)' }}>
                        {mat.name}
                      </span>
                      <span className="text-sm font-semibold" style={{ color: 'var(--text-secondary)' }}>
                        {formatPrice(mat.price)}/m²
                      </span>
                    </div>
                    <p className="text-sm" style={{ color: 'var(--text-muted)' }}>
                      {mat.description}
                    </p>
                  </div>
                </label>
              )
            })}
          </div>
        </div>

        {/* Price Breakdown */}
        {pricing && (
          <div className="mb-6 p-4 rounded-xl" style={{ background: 'var(--bg-tertiary)' }}>
            <h3 className="text-lg font-semibold mb-3" style={{ color: 'var(--text-primary)' }}>
              Price Breakdown
            </h3>
            <div className="space-y-2 text-sm">
              <div className="flex justify-between" style={{ color: 'var(--text-secondary)' }}>
                <span>Wall area:</span>
                <span style={{ color: 'var(--text-primary)' }}>{pricing.area.toFixed(2)} m²</span>
              </div>
              <div className="flex justify-between" style={{ color: 'var(--text-secondary)' }}>
                <span>Material cost:</span>
                <span style={{ color: 'var(--text-primary)' }}>{formatPrice(pricing.subtotal)}</span>
              </div>
              <div className="flex justify-between" style={{ color: 'var(--text-secondary)' }}>
                <span>Waste allowance (10%):</span>
                <span style={{ color: 'var(--text-primary)' }}>{formatPrice(pricing.total - pricing.subtotal)}</span>
              </div>
              <div className="border-t pt-2 mt-2" style={{ borderColor: 'var(--border-color)' }}>
                <div className="flex justify-between text-lg font-bold">
                  <span style={{ color: 'var(--text-primary)' }}>Total:</span>
                  <span className="gradient-text">{formatPrice(pricing.total)}</span>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Error Message */}
        {error && (
          <div className="mb-4 p-3 rounded-xl border" style={{ background: 'rgba(239, 68, 68, 0.1)', borderColor: '#ef4444' }}>
            <p className="text-sm" style={{ color: 'var(--text-primary)' }}>{error}</p>
          </div>
        )}

        {/* Submit Button */}
        <button
          type="submit"
          disabled={!pricing}
          className={`w-full px-6 py-3 rounded-lg font-semibold text-lg transition-all duration-200 ${!pricing ? 'opacity-50 cursor-not-allowed' : 'btn-primary glow-accent-hover'}`}
          style={!pricing ? { background: 'var(--bg-tertiary)', color: 'var(--text-muted)' } : {}}
        >
          Proceed to Checkout
        </button>
      </form>
    </div>
  )
}
