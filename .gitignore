*.sqlite
*.sqlite3

# Secrets
secrets/
*.key
*.pem
credentials.json

# Documentation - Exclude ALL planning/guide files from GitHub
# Strategy: Block all .md files first, then whitelist only essential ones

# Block all .md files in root
/*.md

# Whitelist ONLY essential documentation
!README.md
!GET-STARTED.md
!HOW-TO-RUN.md
!STATUS.md
!RUNPOD-SETUP-GUIDE.md

# Keep standard docs if they exist
!LICENSE.md
!CONTRIBUTING.md
!CHANGELOG.md

# Keep README files in subdirectories (like runpod/README.md)
!*/README.md
